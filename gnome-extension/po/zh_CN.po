msgid "ChargeGuard"
msgstr "充电守护"

msgid "Manage native battery charging modes from GNOME Quick Settings."
msgstr "从 GNOME Quick Settings 管理原生电池充电模式。"

msgid "Unknown"
msgstr "未知"

msgid "Battery"
msgstr "电池"

msgid "Multiple supported batteries were detected. Device selection is not available yet."
msgstr "检测到多个受支持的电池，但暂不支持选择设备。"

msgid "This battery does not expose native charge modes."
msgstr "此电池未暴露原生充电模式。"

msgid "No present battery was detected."
msgstr "未检测到当前可用的电池。"

msgid "No supported battery charge-mode interface was detected."
msgstr "未检测到受支持的电池充电模式接口。"

msgid "Loading"
msgstr "正在加载"

msgid "Loading battery charge modes"
msgstr "正在加载电池充电模式"

msgid "Reading battery charge modes"
msgstr "正在读取电池充电模式"

msgid "Permission denied"
msgstr "权限被拒绝"

msgid "Unsupported"
msgstr "不支持"

msgid "Backend unavailable"
msgstr "后端不可用"

msgid "Error"
msgstr "错误"

msgid "Unexpected ChargeGuard error"
msgstr "ChargeGuard 出现意外错误"

msgid "read-only"
msgstr "只读"

msgid "Mode switching is not writable on this device."
msgstr "此设备上的模式切换不可写。"

msgid "No supported modes were reported."
msgstr "未报告任何受支持的模式。"
