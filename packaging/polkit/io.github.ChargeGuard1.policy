<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ChargeGuard</vendor>
  <vendor_url>https://github.com/Ca11back/ChargeGuard</vendor_url>

  <action id="io.github.ChargeGuard1.set-native-mode">
    <description>Change native battery charging mode</description>
    <message>Authentication is required to change the native battery charging mode.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
